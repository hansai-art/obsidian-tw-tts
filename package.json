{
	"name": "obsidian-tw-tts",
	"version": "0.13.6",
	"description": "Traditional-Chinese-first Obsidian read-aloud plugin with system, Edge CLI or Azure voices and sentence-by-sentence highlighting.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src/",
		"test": "NODE_NO_WARNINGS=1 tsx --tsconfig tsconfig.test.json --test tests/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tts",
		"text-to-speech",
		"chinese",
		"accessibility"
	],
	"author": "Hans Lin",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "^1.5.8",
		"tslib": "2.6.2",
		"tsx": "^4.20.6",
		"typescript": "5.3.3"
	}
}
